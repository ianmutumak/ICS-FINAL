{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered warehouse logistics and operational staff profile",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "staffNumber": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "department": { "type": "string" },
        "email": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "on_leave", "suspended"] },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "staffNumber", "name", "role", "department"]
    },
    "Shift": {
      "title": "Shift",
      "description": "Shift handover session and turnover record",
      "type": "object",
      "properties": {
        "shiftId": { "type": "string" },
        "handoverCode": { "type": "string" },
        "departmentId": { "type": "string" },
        "shiftType": { "type": "string", "enum": ["morning", "evening", "night"] },
        "shiftDate": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "in_progress", "pending_signoff", "completed"] },
        "leadOutgoingId": { "type": "string" },
        "leadIncomingId": { "type": "string" },
        "transitionDurationMinutes": { "type": "number" },
        "isOverridden": { "type": "boolean" },
        "overrideReason": { "type": "string" }
      },
      "required": ["shiftId", "handoverCode", "departmentId", "shiftType", "status"]
    },
    "Task": {
      "title": "Task",
      "description": "Cross-shift actionable order or freight task",
      "type": "object",
      "properties": {
        "taskId": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["urgent", "high", "normal"] },
        "departmentId": { "type": "string" },
        "assignedTo": { "type": "string" },
        "dueTime": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "completed", "carried_over"] },
        "carriedOverFromPrevious": { "type": "boolean" }
      },
      "required": ["taskId", "title", "departmentId", "priority", "status"]
    },
    "Incident": {
      "title": "Incident",
      "description": "Operational hazard or warehouse event tracking",
      "type": "object",
      "properties": {
        "incidentId": { "type": "string" },
        "departmentId": { "type": "string" },
        "title": { "type": "string" },
        "severity": { "type": "string", "enum": ["critical", "major", "moderate", "minor"] },
        "status": { "type": "string", "enum": ["open", "investigating", "resolved"] },
        "reportedBy": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "mitigationNotes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["incidentId", "departmentId", "title", "severity", "status"]
    },
    "Department": {
      "title": "Department",
      "description": "Warehouse operational zone or freight facility unit",
      "type": "object",
      "properties": {
        "departmentId": { "type": "string" },
        "code": { "type": "string" },
        "name": { "type": "string" },
        "building": { "type": "string" },
        "floor": { "type": "string" },
        "capacity": { "type": "number" },
        "headOfDepartment": { "type": "string" }
      },
      "required": ["departmentId", "code", "name"]
    },
    "AdminOverrideLog": {
      "title": "AdminOverrideLog",
      "description": "Privileged audit trail of administrative shift interventions",
      "type": "object",
      "properties": {
        "overrideId": { "type": "string" },
        "shiftId": { "type": "string" },
        "adminId": { "type": "string" },
        "adminName": { "type": "string" },
        "actionType": { "type": "string" },
        "reason": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["overrideId", "shiftId", "adminId", "reason", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and RBAC role assignments"
    },
    "/departments/{departmentId}": {
      "schema": "Department",
      "description": "Warehouse operational facility zones"
    },
    "/shifts/{shiftId}": {
      "schema": "Shift",
      "description": "Shift handover sessions and status records"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Cross-shift freight and logistics action queue"
    },
    "/incidents/{incidentId}": {
      "schema": "Incident",
      "description": "Incident carry-overs and resolution logs"
    },
    "/admin_overrides/{overrideId}": {
      "schema": "AdminOverrideLog",
      "description": "Administrative override ledger"
    }
  }
}
