# Copy this file to .env and fill it in. Never commit .env.

# MongoDB connection string, for example from MongoDB Atlas (Connect > Drivers).
MONGODB_URI=
MONGODB_DB=zamucheck

# A long random string that signs session cookies (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Creates the first administrator the first time the server starts with an empty database.
# Remove INITIAL_ADMIN_PIN from the environment once it has been used.
INITIAL_ADMIN_BADGE=
INITIAL_ADMIN_NAME=Administrator
INITIAL_ADMIN_PIN=

# Accounts are created by an administrator. Set to true only to allow people to register themselves.
ALLOW_SELF_REGISTRATION=false

# Time zone used for shift dates and times.
APP_TIMEZONE=Africa/Nairobi

# Optional: other web addresses allowed to call the API, separated by commas.
ALLOWED_ORIGINS=

PORT=3004
