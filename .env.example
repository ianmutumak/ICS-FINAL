# Local development: use the Ollama service on this computer (no API key needed).
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# Download the model once with: ollama pull qwen2.5:3b
# To use Gemini instead, set AI_PROVIDER=gemini and configure a server-only key:
# GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
# GEMINI_MODEL="gemini-3.5-flash-lite"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
