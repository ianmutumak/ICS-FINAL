rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default connection test doc
    match /test/{docId} {
      allow read, write: if true;
    }

    // Facility Zones & Departments Collection
    match /departments/{deptId} {
      allow read, write: if true;
    }

    // Shifts & Handover Sessions Collection (including subcollections like cases)
    match /shifts/{shiftId} {
      allow read, write: if true;
      match /{allSubcollections=**} {
        allow read, write: if true;
      }
    }

    // Tasks Hub Collection
    match /tasks/{taskId} {
      allow read, write: if true;
    }

    // Incidents Collection
    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    // Admin Overrides Audit Log (Immutable writes)
    match /admin_overrides/{overrideId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Institutional Operational Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
